# EgoRank Environment Configuration (Never commit real credentials)

# Application URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cashfree Payments (India - INR / UPI / Domestic Cards)
# Keep CASHFREE_ENV="sandbox" until Cashfree approves live production transactions
CASHFREE_ENV="sandbox"
CASHFREE_CLIENT_ID="your_cashfree_sandbox_client_id"
CASHFREE_CLIENT_SECRET="your_cashfree_sandbox_client_secret"
CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_secret"

# PayPal Checkout (International - USD)
# Keep PAYPAL_ENV="sandbox" until PayPal approves live production transactions
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"

# Stripe (Modular - Future / Approved Use Only)
STRIPE_SECRET_KEY="sk_test_your_stripe_test_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Resend Transactional Email
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="EgoRank <concierge@egorank.example>"

# Supabase / PostgreSQL Reference (Optional for external SQL migration deployment)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Gemini API (Injected by AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
